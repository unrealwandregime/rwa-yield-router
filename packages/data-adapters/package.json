{
  "name": "@rwa-yield-router/data-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./production-catalog.json": "./data/production-catalog.json"
  },
  "files": [
    "data",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "data:validate": "tsx scripts/validate-catalog.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
