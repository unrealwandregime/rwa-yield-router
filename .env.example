# Runtime
NODE_ENV=development
# Use preview only for a truthfully degraded non-production deployment.
DEPLOYMENT_TIER=production
TRUSTED_PROXY_MODE=none
APP_URL=http://localhost:3000
LOG_LEVEL=info
DATA_ENCRYPTION_KEY=
CRON_SHARED_SECRET=
PORT=3000

# PostgreSQL and Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rwa_yield_router
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/rwa_yield_router
REDIS_URL=redis://localhost:6379

# Worker process
WORKER_ENABLED=true
WORKER_PORT=3001
WORKER_CONCURRENCY=4
WORKER_DRAIN_DELAY_SECONDS=5
SCHEDULES_ENABLED=true
INGEST_INTERVAL_MS=900000
RISK_INTERVAL_MS=3600000
ALERT_INTERVAL_MS=300000
ROLLUP_INTERVAL_MS=86400000

# Supabase Auth (the anon key is intentionally browser-safe; the service role key is secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Read-only provider configuration
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
MORPHO_API_URL=https://api.morpho.org/graphql
# Disable only in deterministic browser tests or a deliberately degraded deployment.
REQUEST_TIME_PROVIDER_FETCH_ENABLED=true
PRICE_PROVIDER_URL=
PRICE_PROVIDER_API_KEY=

# Notifications
EMAIL_TRANSPORT=console
EMAIL_FROM=alerts@example.invalid
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Observability
# external requires SENTRY_DSN and/or OTEL_EXPORTER_OTLP_ENDPOINT in production.
# platform sends explicit worker capture events to the redacted structured log stream.
OBSERVABILITY_MODE=external
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
SECURITY_CONTACT_URL=https://github.com/unrealwandregime/rwa-yield-router/security/advisories/new

# Server-only admin bootstrap. The target must sign in once first. Remove after the audited grant.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_AUTH_SUBJECT=
INITIAL_ADMIN_REASON=
